{
  "name": "@tawaship/pixi-animate-runtime",
  "version": "0.1.0",
  "description": "Plays Adobe Animate HTML5 Canvas content on PixiJS from definitions extracted by @tawaship/animate-data-converter.",
  "main": "dist/pixi-animate-runtime.cjs.js",
  "module": "dist/pixi-animate-runtime.esm.js",
  "browser": "dist/pixi-animate-runtime.js",
  "types": "types/player/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/player/index.d.ts",
      "import": "./dist/pixi-animate-runtime.esm.js",
      "require": "./dist/pixi-animate-runtime.cjs.js"
    },
    "./generator": {
      "types": "./types/generator/generator/index.d.ts",
      "require": "./dist/generator.cjs.js"
    }
  },
  "bin": {
    "pixi-animate-runtime": "bin/pixi-animate-runtime.js"
  },
  "files": [
    "dist",
    "types",
    "bin",
    "tools"
  ],
  "scripts": {
    "rollup": "rollup -c --bundleConfigAsCjs",
    "d": "tsc -p tsconfig.player.json --emitDeclarationOnly --declaration --outDir ./types/player && tsc -p tsconfig.generator.json --emitDeclarationOnly --declaration --outDir ./types/generator",
    "build": "npm run rollup -- --environment PROD && npm run d && echo done.",
    "docs": "typedoc"
  },
  "keywords": [
    "pixi.js",
    "adobe-animate",
    "createjs"
  ],
  "author": "tawaship",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tawaship/pixi-animate-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/tawaship/pixi-animate-runtime/issues"
  },
  "homepage": "https://tawaship.github.io/pixi-animate-runtime/",
  "peerDependencies": {
    "pixi.js": "^5.3.2"
  },
  "dependencies": {
    "@tawaship/animate-data-converter": "^0.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-buble": "^1.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^20.19.43",
    "del": "^8.0.1",
    "pixi.js": "5.3.9",
    "rollup": "^4.65.0",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
